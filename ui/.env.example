# ProofMatch browser demo — copy to `ui/.env.local` and restart `npm run dev`.
#
# Without these the UI silently falls back to the DEMO shell: no Midnight, no
# Lace, no real ledger. The header then reads "Wallet not detected" because
# nothing ever asks the extension anything.
#
# The indexer, node and prover URIs are NOT set here on purpose: Lace reports
# them through `getConfiguration()`, and the app refuses a non-local prover.

# Deployed ProofMatch V1 job the UI reads and proves against.
# Run `npx tsx scripts/deploy-demo-job.ts` and paste the address it prints:
VITE_PROOFMATCH_CONTRACT_ADDRESS=

# Must match the network Lace is on. Local devnet is `undeployed`.
VITE_PROOFMATCH_NETWORK_ID=undeployed

# Encrypts the browser private-state store. The SDK validates this: at least 16
# characters and 3 of uppercase/lowercase/digits/symbols, or it throws when the
# store is first opened. Local demo value; never a seed or a wallet credential.
VITE_PROOFMATCH_PRIVATE_STATE_PASSWORD=ProofMatch-Local-Demo-7

# Optional. Defaults to the page origin, which is what serves the ZK assets.
# Only set it if the keys are hosted somewhere else.
# VITE_PROOFMATCH_ZK_CONFIG_BASE_URL=http://localhost:5173

# Optional. IndexedDB store name for the candidate private state.
# VITE_PROOFMATCH_PRIVATE_STATE_STORE_NAME=proofmatch-browser-state
