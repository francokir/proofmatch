// Fixture de test. NO forma parte del contrato de ProofMatch y no se compila
// con `npm run compile`; lo compila la suite de tests bajo demanda.
//
// Contrato DELIBERADAMENTE ROTO: incrementa `matchCount` ANTES de validar nada.
// Existe para probar que la suite detecta esa clase de bug. Si un test de
// "no muta ante un fallo" pasa contra este fixture, ese test no sirve.
//
// La propiedad que fija: `matchCount += 1` tiene que ser la ÚLTIMA operación
// del circuito, después de todos los assert. Ni el compilador ni el runtime
// obligan ese orden; el único guardián es el test.

pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum JobState {
  OPEN,
  CLOSED
}

export sealed ledger jobId: Bytes<32>;
export sealed ledger jobMaximumCompensation: Uint<64>;
export sealed ledger jobRequiredWeeklyHours: Uint<8>;
export ledger jobState: JobState;
export ledger matchCount: Counter;

witness candidateMinimumCompensation(): Uint<64>;
witness candidateAvailableWeeklyHours(): Uint<8>;

constructor(
  id: Bytes<32>,
  maximumCompensation: Uint<64>,
  requiredWeeklyHours: Uint<8>
) {
  jobId = disclose(id);
  jobMaximumCompensation = disclose(maximumCompensation);
  jobRequiredWeeklyHours = disclose(requiredWeeklyHours);
  jobState = JobState.OPEN;
}

export circuit proveMatch(): [] {
  // EL BUG: la escritura pública ocurre primero.
  matchCount += 1;

  assert(jobState == JobState.OPEN, "ProofMatch: job is not open");
  assert(jobId != default<Bytes<32>>, "ProofMatch: malformed job terms");
  assert(jobMaximumCompensation > 0, "ProofMatch: malformed job terms");
  assert(jobRequiredWeeklyHours > 0, "ProofMatch: malformed job terms");
  assert(jobRequiredWeeklyHours <= 168, "ProofMatch: malformed job terms");

  const _minimumCompensation = candidateMinimumCompensation();
  const _availableWeeklyHours = candidateAvailableWeeklyHours();

  assert(_minimumCompensation > 0, "ProofMatch: candidate compensation out of range");
  assert(_availableWeeklyHours > 0, "ProofMatch: candidate weekly hours out of range");
  assert(_availableWeeklyHours <= 168, "ProofMatch: candidate weekly hours out of range");

  assert(_minimumCompensation <= jobMaximumCompensation,
         "ProofMatch: compensation not compatible");
  assert(_availableWeeklyHours >= jobRequiredWeeklyHours,
         "ProofMatch: weekly hours not compatible");
}
